  "panels": [
    {
      "id": 1,
      "title": "Firewall gözlemi",
      "description": "Exporter erişimi ve10s içindeki sağlıklı veri yolu gözlemi birlikte değerlendirilir.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wirewall-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"wirewall\"}) * (min(wirewall_up) or vector(0))",
          "legendFormat": "Firewall gözlemi",
          "datasource": {
            "type": "prometheus",
            "uid": "wirewall-prometheus"
          },
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SAĞLIKLI DEĞİL",
                  "color": "red"
                },
                "1": {
                  "text": "SAĞLIKLI",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
